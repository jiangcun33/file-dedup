{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "文件去重",
  "version": "0.2.1",
  "identifier": "com.filededup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "文件去重",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "D:/filededup-icons/32x32.png",
      "D:/filededup-icons/128x128.png",
      "D:/filededup-icons/128x128@2x.png",
      "D:/filededup-icons/icon.icns",
      "D:/filededup-icons/icon.ico"
    ],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "resources/ffmpeg.exe": "ffmpeg.exe"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
